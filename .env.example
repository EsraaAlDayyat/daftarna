# Firebase web app config.
# Firebase Console → Project settings → General → Your apps → Web app → SDK setup and configuration.
# Leave these empty to run the in-browser demo instead.
#
# Note: these values are bundled into the client and visible to anyone who opens the app.
# That is expected for Firebase web apps; access is enforced by firestore.rules, not by hiding them.
# Never put server secrets (like the Anthropic API key) in a VITE_ variable.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web push key: Project settings → Cloud Messaging → Web Push certificates → Key pair
VITE_FIREBASE_VAPID_KEY=
