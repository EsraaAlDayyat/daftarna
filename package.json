{
  "name": "daftarna",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run && npm --prefix functions test",
    "test:rules": "firebase emulators:exec --project demo-daftarna --only firestore \"vitest run --config rules-tests/vitest.config.ts\"",
    "test:e2e": "node e2e/run.mjs",
    "typecheck": "tsc -b && npm --prefix functions run typecheck"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/reem-kufi": "^5.3.0",
    "firebase": "^12.19.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase-tools": "^15.33.0",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  },
  "license": "MIT",
  "description": "Shared IOU ledger and receipt splitting for friends, in Arabic.",
  "overrides": {
    "@firebase/app": "0.16.3",
    "@firebase/app-compat": "0.5.19"
  }
}
