rules_version = '2';

// Security rules. Each user can only read transactions they are a party to,
// and transactions are append-only (no updates, no deletes).
// Identity is the phone number verified by SMS (request.auth.token.phone_number).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.phone_number is string;
    }
    function me() { return request.auth.token.phone_number; }
    function isPhone(p) { return p is string && p.matches('^[+][1-9][0-9]{7,14}$'); }
    function validName(n) { return n is string && n.size() > 0 && n.size() <= 40; }

    // ───── Profile ─────
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['phone', 'name'])
        && request.resource.data.phone == me()
        && validName(request.resource.data.name);

      // My contacts (names I chose). Private to me.
      match /contacts/{phone} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && isPhone(phone)
          && request.resource.data.keys().hasOnly(['phone', 'name'])
          && request.resource.data.phone == phone
          && validName(request.resource.data.name);
      }

      // Push notification tokens
      match /tokens/{t} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['token', 'createdAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() < 400;
      }
    }

    // ───── Phone directory: who has the app ─────
    // Lookup of a single number (get) only. Listing the directory is denied.
    match /phones/{phone} {
      allow get: if signedIn();
      allow list: if false;
      allow create, update: if signedIn() && phone == me()
        && request.resource.data.keys().hasOnly(['uid', 'name'])
        && request.resource.data.uid == request.auth.uid
        && validName(request.resource.data.name);
      allow delete: if false;
    }

    // ───── Transactions ─────
    match /txns/{id} {
      allow read: if signedIn() && me() in resource.data.parties;
      allow update, delete: if false;
      allow create: if signedIn() && validTxn(request.resource.data) && (
        // Regular entry: I must be one of the two parties
        (me() in request.resource.data.parties
          && request.resource.data.kind in ['lend', 'paidFor', 'repay', 'settle'])
        // Bill share: must match the bill written in the same batch
        || (request.resource.data.kind == 'split' && splitOk(request.resource.data))
        // Reversal: only of an entry I created, and only once
        || (request.resource.data.kind == 'reversal' && reversalOk(request.resource.data))
      );
    }

    function validTxn(d) {
      return d.keys().hasAll(['creditor', 'debtor', 'parties', 'amount', 'kind', 'note', 'createdBy', 'createdByName', 'createdAt'])
        && d.keys().hasOnly(['creditor', 'debtor', 'parties', 'amount', 'kind', 'note', 'createdBy', 'createdByName', 'createdAt', 'billId', 'reverses'])
        && isPhone(d.creditor) && isPhone(d.debtor) && d.creditor != d.debtor
        && d.parties == [d.creditor, d.debtor]
        && d.amount is int && d.amount > 0 && d.amount <= 100000000
        && d.note is string && d.note.size() <= 120
        && d.createdBy == me()
        && d.createdByName is string && d.createdByName.size() <= 40
        && d.createdAt == request.time
        && (d.kind == 'split') == ('billId' in d)
        && (d.kind == 'reversal') == ('reverses' in d);
    }

    function splitOk(d) {
      let bill = getAfter(/databases/$(database)/documents/bills/$(d.billId)).data;
      return bill.createdBy == me()
        && bill.createdAt == request.time
        && d.creditor == bill.payer
        && bill.shares[d.debtor] == d.amount;
    }

    function reversalOk(d) {
      let orig = get(/databases/$(database)/documents/txns/$(d.reverses)).data;
      return orig.createdBy == me()
        && orig.kind != 'reversal'
        && d.creditor == orig.debtor && d.debtor == orig.creditor
        && d.amount == orig.amount
        // Reversal marker: written in the same batch, must not exist before
        && !exists(/databases/$(database)/documents/reversals/$(d.reverses))
        && existsAfter(/databases/$(database)/documents/reversals/$(d.reverses));
    }

    match /reversals/{origId} {
      allow read: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['by'])
        && request.resource.data.by == me();
      allow update, delete: if false;
    }

    // ───── Bills ─────
    match /bills/{id} {
      allow read: if signedIn() && me() in resource.data.parties;
      allow create: if signedIn()
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && me() in request.resource.data.parties
        && request.resource.data.payer in request.resource.data.parties
        && request.resource.data.parties.size() <= 30
        && request.resource.data.total is int
        && request.resource.data.restaurant is string && request.resource.data.restaurant.size() <= 60;
      allow update, delete: if false;
    }

    // ───── Groups ─────
    // The document ID is random and works as the invite link: anyone signed in
    // who has the link can read the group and add themselves. Members can add
    // others and rename the group. Nobody can be removed yet.
    function validGroup(d) {
      return d.keys().hasOnly(['name', 'emoji', 'members', 'names', 'createdBy', 'createdAt'])
        && validName(d.name)
        && d.emoji is string && d.emoji.size() <= 8
        && d.members is list && d.members.size() >= 1 && d.members.size() <= 50
        && d.names is map && d.names.keys().toSet() == d.members.toSet();
    }

    match /groups/{gid} {
      allow get: if signedIn();
      allow list: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && validGroup(request.resource.data)
        && request.resource.data.members == [me()]
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && validGroup(request.resource.data)
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.members.hasAll(resource.data.members)
        && (
          // A member can add people and edit the group
          me() in resource.data.members
          // Someone with the link can only add themselves
          || (request.resource.data.members.toSet().difference(resource.data.members.toSet()) == [me()].toSet()
              && request.resource.data.names.diff(resource.data.names).affectedKeys().hasOnly([me()])
              && request.resource.data.name == resource.data.name
              && request.resource.data.emoji == resource.data.emoji)
        );
      allow delete: if false;
    }

    // ───── Group orders: who wants what, before the bill ─────
    match /orders/{id} {
      allow read: if signedIn() && me() in resource.data.parties;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['groupId', 'title', 'lines', 'parties', 'createdBy', 'createdAt', 'status'])
        && request.resource.data.createdBy == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.status == 'open'
        && request.resource.data.title is string && request.resource.data.title.size() <= 60
        && request.resource.data.lines is map && request.resource.data.lines.size() == 0
        && me() in request.resource.data.parties
        && request.resource.data.parties.size() <= 50
        && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.members.hasAll(request.resource.data.parties);
      allow update: if signedIn() && me() in resource.data.parties
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lines', 'status', 'title'])
        && request.resource.data.lines.keys().hasOnly(resource.data.parties)
        && request.resource.data.status in ['open', 'done']
        && request.resource.data.title is string && request.resource.data.title.size() <= 60;
      allow delete: if false;
    }

    // ───── Comments on an entry ─────
    // Both parties of the entry can read and add them. They can't be edited or deleted.
    match /comments/{id} {
      allow read: if signedIn() && me() in resource.data.parties;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['txnId', 'by', 'byName', 'text', 'parties', 'createdAt'])
        && request.resource.data.txnId is string
        && request.resource.data.by == me()
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 40
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 300
        && request.resource.data.createdAt == request.time
        && me() in request.resource.data.parties
        && request.resource.data.parties == get(/databases/$(database)/documents/txns/$(request.resource.data.txnId)).data.parties;
      allow update, delete: if false;
    }

    // Receipt-reading usage counters (server only)
    match /usage/{doc} {
      allow read, write: if false;
    }
  }
}
